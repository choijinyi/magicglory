{
  "name": "glorymagic-replica",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "admin:configure": "powershell.exe -NoProfile -File scripts/set-admin.ps1",
    "build": "node scripts/build.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate-turso.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-artifact.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@libsql/client": "0.18.0"
  }
}
